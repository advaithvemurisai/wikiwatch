# Copy to .env.local with `make env-local`, which replaces every "changeme" value with a
# random throwaway secret. Never put real cloud credentials in an env file: cloud secrets
# live only in SSM Parameter Store.

# Catalog: "rest" locally (Iceberg REST catalog + SeaweedFS), "glue" on EC2 (Glue + S3).
CATALOG_TYPE=rest
CATALOG_URI=http://iceberg-rest:8181
WAREHOUSE_BUCKET=warehouse
AWS_REGION=us-east-1

# Local S3 (SeaweedFS). On EC2 the endpoint is empty and the instance role provides access;
# the boot script sets the keys to an unused placeholder (see docker-compose.aws.yml).
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme

# Producer. Wikimedia requires a descriptive User-Agent with contact details, e.g.
# WikiWatch/0.1 (https://github.com/<you>/wikiwatch). Fill it in .env.local; never commit it.
WIKIWATCH_USER_AGENT=
# Start mode for `docker compose`; `make produce MODE=...` overrides it.
PRODUCER_MODE=resume

# Spark micro-batch trigger. Keep 1 minute; only the e2e test shortens it.
STREAM_TRIGGER=1 minute

# Local Postgres: superuser, Iceberg REST catalog role, Airflow role (local only;
# the cloud values come from SSM)
POSTGRES_PASSWORD=changeme
CATALOG_DB_PASSWORD=changeme
AIRFLOW_DB_PASSWORD=changeme

# Airflow
AIRFLOW_FERNET_KEY=changeme
AIRFLOW_JWT_SECRET=changeme
AIRFLOW_API_SECRET_KEY=changeme

# Memory limits per service. Defaults fit an 8 GB M1 Air with Docker at 6 GB:
# core about 5.3 GB (with Postgres), dbt (Trino) 2 GB, airflow about 1.8 GB, producer 192 MB. Raise SPARK_* on EC2.
REDPANDA_MEM_LIMIT=768m
CONSOLE_MEM_LIMIT=256m
SEAWEEDFS_MEM_LIMIT=512m
SEAWEEDFS_INIT_MEM_LIMIT=128m
ICEBERG_REST_MEM_LIMIT=384m
SPARK_MEM_LIMIT=3072m
SPARK_DRIVER_MEMORY=1536m
TRINO_MEM_LIMIT=2g
POSTGRES_MEM_LIMIT=256m
AIRFLOW_MEM_LIMIT=1792m
PRODUCER_MEM_LIMIT=192m
