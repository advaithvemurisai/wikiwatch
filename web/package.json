{
  "name": "wikiwatch-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "copy-schemas": "node scripts/copy-schemas.mjs",
    "predev": "npm run copy-schemas",
    "dev": "next dev",
    "prebuild": "npm run copy-schemas",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "npm run copy-schemas",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run copy-schemas",
    "test": "vitest run",
    "validate-fixtures": "node scripts/validate-fixtures.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@vercel/oidc-aws-credentials-provider": "3.3.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
